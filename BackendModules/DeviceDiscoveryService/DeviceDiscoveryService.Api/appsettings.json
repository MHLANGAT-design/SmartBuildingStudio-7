{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Api": {
    "ServiceName": "DeviceDiscoveryService",
    "EnableSwagger": true,
    "CorsOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },

  "DeviceDiscoveryPersistence": {
    "ConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=DeviceDiscoveryDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },

  "DeviceDiscoveryInfrastructure": {
    "UseMockIntegrations": true,
    "GatewayManagementBaseUrl": "http://localhost:5100",
    "ProjectExplorerBaseUrl": "http://localhost:5199",
    "TimeoutSeconds": 30
  },

  "GatewayDiscovery": {
    "BaseUrl": "http://localhost:5100",
    "TimeoutSeconds": 30
  },

  "ProjectDesign": {
    "BaseUrl": "http://localhost:5199",
    "TimeoutSeconds": 30
  }
}